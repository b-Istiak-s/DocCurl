{
  "name": "doccurl",
  "version": "1.1.0",
  "description": "Interactive curl command documentation viewer with live playground",
  "main": "server/index.js",
  "bin": {
    "doccurl": "cli/index.js"
  },
  "scripts": {
    "dev": "npx nodemon -e js,json,html,css,md -x \"node cli/index.js serve --port 3000 --dir docs --dev\"",
    "start": "node cli/index.js serve --port 3000 --dir docs",
    "test": "node --test"
  },
  "keywords": [
    "curl",
    "documentation",
    "interactive",
    "playground",
    "api",
    "testing",
    "markdown"
  ],
  "author": "Billy Istiak <billyistiak@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b-Istiak-s/doccurl.git"
  },
  "bugs": {
    "url": "https://github.com/b-Istiak-s/doccurl/issues"
  },
  "homepage": "https://github.com/b-Istiak-s/doccurl#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "markdown-it": "^14.1.1"
  }
}
